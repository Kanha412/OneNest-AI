# =============================================================================
# OneNest -- Environment Variable Reference
# =============================================================================
# This file documents every environment variable required by the backend.
# It contains PLACEHOLDER values only -- never real secrets.
# Copy to .env for local experimentation (it is git-ignored).
#
# In production, set these as "Secret Environment Variables" in the Render
# dashboard for the backend Web Service. They will be injected into the
# container at runtime and are never stored in the Docker image or source code.
# =============================================================================

# -- Database -----------------------------------------------------------------
# Supabase PostgreSQL connection string (Transaction Pooler recommended).
# Format: Host=...;Port=5432;Database=postgres;Username=postgres.<ref>;Password=...;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=

# -- JWT ----------------------------------------------------------------------
# Generate a cryptographically secure key: openssl rand -base64 64
# Minimum recommended length: 64 characters.
Jwt__Key=
Jwt__Issuer=OneNest.API
Jwt__Audience=OneNest.Client

# -- Gemini AI ----------------------------------------------------------------
# Server-side only -- never expose to the Angular frontend.
AI__ApiKey=
AI__Provider=Gemini
AI__Model=gemini-2.5-flash

# -- Embeddings (local ONNX -- no API key required) --------------------------
Embeddings__Provider=Local
Embeddings__Dimension=384
# Path to the bundled model inside the Docker image (set in Dockerfile ENV).
LocalEmbedding__ModelDirectory=/app/models/all-MiniLM-L6-v2

# -- Supabase Storage ---------------------------------------------------------
# Server-side only -- the service-role key must NEVER reach the Angular frontend.
Supabase__Url=https://<project-ref>.supabase.co
Supabase__ServiceRoleKey=
Supabase__StorageBucket=onenest-documents

# -- CORS ---------------------------------------------------------------------
# Set to your deployed Angular Render URL.
# Add more origins by incrementing the index (0, 1, 2, ...).
Cors__AllowedOrigins__0=https://<your-angular-app>.onrender.com

# -- Port (Render sets this automatically) ------------------------------------
# Render injects PORT=10000 (or whatever port you configured) at runtime.
# The Dockerfile entrypoint reads $PORT; you do not need to set this manually.
# PORT=10000
